# =============================================================================
# Global configuration
# =============================================================================

# Cluster base domain. Services are served at <service>.<BASE_DOMAIN>; Arcane
# is served at arcane.<BASE_DOMAIN>.
BASE_DOMAIN=example.com

# Docker network shared with the external reverse proxy (nginx-proxy).
# Must already exist; the project only joins it, it does not create it.
# Optional — defaults to "web-proxy" when unset.
NGINX_PROXY_NETWORK=web-proxy

# Timezone for services that honor TZ (IANA name, e.g. Europe/Berlin).
TZ=UTC

# --- arcane ---

# Upstream Arcane manager image tag. Tracks "latest" — acceptable here because
# Arcane is a non-vital third-party container; no pin needed for reproducibility.
ARCANE_VERSION=latest

# Optional. Self-signed TLS opt-in for the LAN proxy variant. Defaults to
# "false" (ACME-only / internet-facing deployment); set to "true" to have the
# cluster's local cert generator issue a self-signed cert for
# arcane.<BASE_DOMAIN>, e.g. for local testing.
ARCANE_GEN_SELF_SIGNED_CERT=true

# 32-byte encryption key used to encrypt stored secrets.
# Generate a real value, e.g.: openssl rand -hex 32
ARCANE_ENCRYPTION_KEY=changeme-generate-with-openssl-rand-hex-32

# Secret used to sign JWT session tokens.
# Generate a real value, e.g.: openssl rand -hex 32
ARCANE_JWT_SECRET=changeme-generate-with-openssl-rand-hex-32

# Optional. Comma-separated list of proxy CIDRs/IPs trusted to set
# X-Forwarded-* headers. Leave empty to trust none.
ARCANE_TRUSTED_PROXIES=
